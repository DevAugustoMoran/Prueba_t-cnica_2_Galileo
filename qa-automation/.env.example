# Copiá este archivo a .env y ajustá lo que corresponda.
# .env NO se sube al repo (ver .gitignore) porque contiene credenciales de prueba.

MOODLE_BASE_URL=http://localhost:8080

# Cuenta admin real de tu instancia -- la que usás vos para entrar por el navegador.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ClaveAdmin123!

# Estas dos cuentas las crea/actualiza automáticamente reset_y_seed.php.
# Si cambiás estos valores, actualizá también la constante QA_PASSWORD en
# src_plugin/local_qa_seed/cli/reset_y_seed.php para que coincidan.
TEACHER_USERNAME=qa_profesor
TEACHER_PASSWORD=ClaveSegura123!
STUDENT_USERNAME=qa_estudiante
STUDENT_PASSWORD=ClaveSegura123!

COURSE_SHORTNAME=QA-AUTOMATION

# Nombre del servicio/contenedor de Moodle en docker-compose.yml (para el script
# de seed, que ejecuta el CLI de PHP adentro del contenedor vía docker compose exec).
MOODLE_COMPOSE_SERVICE=moodle
